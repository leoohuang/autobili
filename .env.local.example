# Required: OpenAI API Key
OPENAI_API_KEY=sk-xxx

# Optional: OpenAI Model (default: gpt-4o)
# Supported models: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o

# Optional: max subtitle characters sent to the model (default: 24000, min: 1000)
# Long videos get truncated to this length before analysis so they don't
# overflow the model context window. Lower it for small-context models
# (gpt-4 = 8k, gpt-3.5-turbo = 16k); raise it for gpt-4o if you want more
# of a long video analysed.
# MAX_TRANSCRIPT_CHARS=24000
